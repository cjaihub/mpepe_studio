{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "storage": [
    {
      "rules": "storage.rules"
    }
  ],
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "mpepe-2b4bd",
          "appId": "1:90836164478:android:f4839af02373b3d9a91d2f",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "mpepe-2b4bd",
          "configurations": {
            "android": "1:90836164478:android:f4839af02373b3d9a91d2f",
            "web": "1:90836164478:web:023f5e7e784d4968a91d2f"
          }
        }
      }
    }
  },
  "emulators": {
    "auth": {
      "port": 9099
