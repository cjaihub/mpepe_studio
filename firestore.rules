rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users
// Document ID: {uid} (Firebase Auth UID)
// Fields:
//   - displayName: string
//   - email: string
//   - photoUrl: string
//   - status: string (e.g. 'active')
//   - role: string (e.g. 'admin', 'user')
//   - Subcollections:
//     - notifications/{notificationId}: notification payload sent to user
//     - youtube_accounts/{accountId}: linked YouTube accounts
//     - {document=**}: other subcollections (settings, preferences, etc.)
//
// Collection: posts
// Document ID: {postId}
// Fields:
//   - authorId: string (immutable owner UID)
//   - caption/description: string
//   - videoUrl/mediaUrl: string
//   - commentCount, reactionCount, likeCount, viewCount, saveCount, repostCount: number
//   - createdAt: timestamp
//   - Subcollections:
//     - comments/{commentId}: comment document
//       - authorId: string
//       - content: string
//       - createdAt: timestamp
//       - reactionCount: number
//
// Collection: stories
// Document ID: {storyId}
// Fields:
//   - authorId: string (creator UID)
//   - mediaUrl: string
//   - mediaType: string
//   - reactions: map
//   - viewers: list
//   - createdAt, expiresAt: timestamp
//
// Collection: content
// Document ID: {contentId}
// Engagement collections:
//   - content_likes, content_saves, content_reposts, content_views, reactions, social_events
//
// Collection: live_streams
// Document ID: {streamId}
// Fields:
//   - id: string
//   - hostId: string (creator UID, immutable)
//   - hostDisplayName: string
//   - hostAvatarUrl: string
//   - title: string (max 200 chars)
//   - category: string
//   - type: string ('singleHost', 'coHost', 'multiGuest', 'interactiveRoom', 'eventStage', 'screenShare')
//   - status: string ('live', 'ended', 'abandoned', etc.)
//   - stageScene: string
//   - stageConfig: map
//   - endpoint: map
//   - aiModerator: map
//   - viewerCount: number
//   - totalLikes: number
//   - totalComments: number
//   - chatSettings: map
//   - coHostIds: list
//   - moderatorIds: list
//   - pinnedCommentId: string (optional)
//   - recordingEnabled: bool
//   - liveCaptionsEnabled: bool
//   - liveTranslationEnabled: bool
//   - audienceMode: string ('public', etc.)
//   - resolution: string
//   - frameRate: number
//   - isMultiPlatform: bool
//   - linkedPlatforms: list
//   - inputSourceMode: string
//   - beautyConfig: map
//   - mediaDeskConfig: map
//   - legalCompliance: map
//   - allowGuestRequests: bool
//   - createdAt: timestamp (immutable)
//   - endedAt: timestamp (optional)
// Subcollections:
//   - comments/{commentId}: chat messages and gifts
//   - participants/{participantId}: active audience and stage speakers
//   - reactions/{reactionId}: hearts and stream reactions
//   - guest_requests/{requestId}: requests to join stage
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isSuspended() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', '') == 'suspended';
    }

    function isActiveUser() {
      return isSignedIn() && !isSuspended() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', '') == 'active';
    }

    function isAdmin() {
      return isSignedIn() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    // True when the update only touches the listed fields.
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Engagement counters any signed-in user may bump on someone else's
    // post/content (likes, comments, views, saves, reposts, shares).
    function isEngagementCounterUpdate() {
      return onlyChanges(['commentCount', 'likeCount', 'reactionCount', 'viewCount',
                          'saveCount', 'repostCount', 'shareCount', 'updatedAt',
                          'viralVelocityScore', 'followerConversions',
                          'completionCount', 'watchTimeMs']) &&
             stepsByOne('commentCount') && stepsByOne('likeCount') &&
             stepsByOne('reactionCount') && stepsByOne('viewCount') &&
             stepsByOne('saveCount') && stepsByOne('repostCount') &&
             stepsByOne('shareCount') && stepsByOne('completionCount');
    }

    // A comment like/unlike: only reactionCount + likerIds change, and the
    // likerIds set gains or loses exactly the caller's uid.
    function isOwnCommentLikeUpdate() {
      let before = resource.data.get('likerIds', []).toSet();
      let after = request.resource.data.get('likerIds', []).toSet();
      return onlyChanges(['reactionCount', 'likerIds']) &&
             after.difference(before).union(before.difference(after)).hasOnly([request.auth.uid]);
    }

    // Owner of the post/content a comment belongs to (either collection).
    function isPostOwner(postId) {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/content/$(postId)) &&
         get(/databases/$(database)/documents/content/$(postId)).data.get('authorId', '') == request.auth.uid) ||
        (exists(/databases/$(database)/documents/posts/$(postId)) &&
         get(/databases/$(database)/documents/posts/$(postId)).data.get('authorId', '') == request.auth.uid)
      );
    }

    // Shared rule body for posts/{postId}/comments and content/{postId}/comments.
    function canCreateComment() {
      return isSignedIn() && !isSuspended() &&
             request.resource.data.authorId == request.auth.uid &&
             request.resource.data.get('content', '') is string &&
             request.resource.data.get('content', '').size() <= 5000;
    }

    function canUpdateComment(postId) {
      return isSignedIn() && !isSuspended() && (
        // Author edits their own comment (authorship is immutable).
        (resource.data.authorId == request.auth.uid &&
         request.resource.data.authorId == resource.data.authorId) ||
        // Anyone signed in may like / unlike, as themselves only.
        isOwnCommentLikeUpdate() ||
        // Post owner may pin or flag a creator reply.
        (isPostOwner(postId) && onlyChanges(['isPinned', 'hasCreatorReply'])) ||
        isAdmin()
      );
    }

    function canDeleteComment(postId) {
      return isSignedIn() &&
             (resource.data.authorId == request.auth.uid || isPostOwner(postId) || isAdmin());
    }

    // Generic ownership check for docs keyed by an owner field.
    function ownsData(data) {
      return isSignedIn() && (
        data.get('ownerId', '') == request.auth.uid ||
        data.get('userId', '') == request.auth.uid ||
        data.get('uid', '') == request.auth.uid ||
        data.get('createdBy', '') == request.auth.uid ||
        data.get('authorId', '') == request.auth.uid
      );
    }

    function isStreamManager(streamId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/live_streams/$(streamId)) && (
               get(/databases/$(database)/documents/live_streams/$(streamId)).data.hostId == request.auth.uid ||
               (('coHostIds' in get(/databases/$(database)/documents/live_streams/$(streamId)).data) &&
                get(/databases/$(database)/documents/live_streams/$(streamId)).data.coHostIds is list &&
                request.auth.uid in get(/databases/$(database)/documents/live_streams/$(streamId)).data.coHostIds) ||
               (('moderatorIds' in get(/databases/$(database)/documents/live_streams/$(streamId)).data) &&
                get(/databases/$(database)/documents/live_streams/$(streamId)).data.moderatorIds is list &&
                request.auth.uid in get(/databases/$(database)/documents/live_streams/$(streamId)).data.moderatorIds) ||
               isAdmin()
             );
    }

    // Clients may never add or change password material on a profile (old
    // hashes are moved server-side to legacy_password_hashes, deny-all).
    function keepsPasswordFieldsOut() {
      return !request.resource.data.keys().hasAny(['passwordHash', 'password']) ||
             (resource != null &&
              request.resource.data.get('passwordHash', null) == resource.data.get('passwordHash', null) &&
              request.resource.data.get('password', null) == resource.data.get('password', null));
    }

    // A counter field either stays put or moves by exactly one (follow/like
    // toggles use FieldValue.increment(±1)); stops clients forging counts.
    function stepsByOne(field) {
      return !(field in request.resource.data.diff(resource.data).affectedKeys()) ||
             (request.resource.data.get(field, 0) is number &&
              request.resource.data.get(field, 0) - resource.data.get(field, 0) >= -1 &&
              request.resource.data.get(field, 0) - resource.data.get(field, 0) <= 1);
    }

    // Owners may edit their profile but never grant themselves admin or lift
    // their own suspension.
    function keepsPrivilegesOnCreate() {
      return request.resource.data.get('role', 'user') != 'admin' &&
             request.resource.data.get('status', 'active') != 'suspended';
    }
    function keepsPrivilegesOnUpdate() {
      return (request.resource.data.get('role', '') == resource.data.get('role', '') ||
              request.resource.data.get('role', '') != 'admin') &&
             (resource.data.get('status', '') != 'suspended' ||
              request.resource.data.get('status', '') == 'suspended');
    }

    // Notifications may only be sent as yourself and may only deep-link to an
    // in-app path ('/...'), never an external URL.
    function isSafeNotification() {
      return request.resource.data.get('actorId', request.auth.uid) == request.auth.uid &&
             (request.resource.data.get('deepLink', null) == null ||
              (request.resource.data.deepLink is string &&
               request.resource.data.deepLink.matches('^/[^/].*$') &&
               request.resource.data.deepLink.size() <= 300));
    }

    // ─── Users ───────────────────────────────────────────────────────────────
    match /users/{uid} {
      // Profiles hold email/phone, so they are visible to signed-in users only.
      allow read: if isSignedIn();
      allow create: if isOwner(uid) && keepsPasswordFieldsOut() && keepsPrivilegesOnCreate();
      allow update: if isOwner(uid) && keepsPasswordFieldsOut() && keepsPrivilegesOnUpdate();
      allow create, update: if isAdmin() && keepsPasswordFieldsOut();
      allow delete: if isOwner(uid) || isAdmin();
      // Follow / unfollow bumps the other user's follower counters by ±1.
      allow update: if isSignedIn() && !isSuspended() &&
                       onlyChanges(['followers', 'following', 'followersCount', 'followingCount', 'likeCount']) &&
                       stepsByOne('followers') && stepsByOne('following') &&
                       stepsByOne('followersCount') && stepsByOne('followingCount') &&
                       stepsByOne('likeCount');

      // Subcollection: Activity notifications sent to this user
      match /notifications/{notificationId} {
        allow create: if isSignedIn() && !isSuspended() && isSafeNotification();
        allow read, update, delete: if isOwner(uid) || isAdmin();
      }

      // Mirror of the user's own comments (comment_service). The owner of the
      // commented post may remove the mirror when deleting the comment.
      match /comments/{commentId} {
        allow delete: if isSignedIn() && isPostOwner(resource.data.postId);
      }

      // Collab invites written into the invited user's inbox by the owner
      // of the content (doc id == contentId).
      match /collab_invites/{contentId} {
        allow create, update, delete: if isSignedIn() && !isSuspended() && isPostOwner(contentId);
      }

      // Subcollection: YouTube accounts
      match /youtube_accounts/{accountId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      // Sign-in log: owner reads, the owner's app only appends, nobody edits.
      match /login_history/{entryId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) &&
          request.resource.data.keys().hasOnly(['deviceId', 'deviceModel', 'os', 'osVersion', 'appVersion',
            'physical', 'success', 'method', 'failureCode', 'newDevice', 'clientAt', 'at', 'location',
            'ipMasked', 'country', 'region', 'city', 'geoSource']) &&
          request.resource.data.success is bool &&
          request.resource.data.method is string && request.resource.data.method.size() <= 80 &&
          request.resource.data.at == request.time;
        allow update, delete: if false;
      }

      // Other user subcollections (settings, private data, etc.).
      // login_history is excluded so it stays append-only.
      match /{sub}/{document=**} {
        allow read, write: if (isOwner(uid) || isAdmin()) && sub != 'login_history';
      }
    }

    // ─── Telemetry Events ────────────────────────────────────────────────────
    match /telemetry_events/{eventId} {
      allow read, write: if isSignedIn();
    }

    // ─── Content & Engagement Collections ────────────────────────────────────
    match /content/{contentId} {
      allow read: if true;
      allow create: if isSignedIn() && !isSuspended() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && !isSuspended() && (
        (resource.data.authorId == request.auth.uid && request.resource.data.authorId == resource.data.authorId) ||
        isEngagementCounterUpdate() ||
        // A collaborator accepting/leaving adds or removes only themselves.
        (onlyChanges(['coAuthorIds']) &&
         request.resource.data.get('coAuthorIds', []).toSet()
           .difference(resource.data.get('coAuthorIds', []).toSet())
           .union(resource.data.get('coAuthorIds', []).toSet()
             .difference(request.resource.data.get('coAuthorIds', []).toSet()))
           .hasOnly([request.auth.uid])) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow read: if true;
        allow create: if canCreateComment();
        allow update: if canUpdateComment(contentId);
        allow delete: if canDeleteComment(contentId);
      }

      // Collab invites / co-authors (collab_service): the content owner
      // invites, the invited user (doc id) responds or leaves.
      match /collaborators/{collaboratorId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && !isSuspended() &&
                        (collaboratorId == request.auth.uid || isPostOwner(contentId));
      }
    }

    // collectionGroup('collaborators') lookup of a user's pending invites.
    match /{path=**}/collaborators/{collaboratorId} {
      allow read: if isSignedIn();
    }
    // Like docs are keyed '<type>_<uid>_<contentId>' and carry userId, so a
    // user can only create/delete their own like — one per user per item.
    match /content_likes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn() && !isSuspended() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    match /posts_likes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn() && !isSuspended() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    // Save / repost / reaction docs carry userId: one per user, own docs only.
    // (resource == null lets the "already saved?" transaction read a missing doc.)
    match /content_saves/{saveId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && !isSuspended() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    match /content_reposts/{repostId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && !isSuspended() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    match /content_views/{viewId} {
      allow read, write: if isSignedIn();
    }
    match /reactions/{reactionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && !isSuspended() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    match /social_events/{eventId} {
      allow read, write: if isSignedIn() && !isSuspended();
    }

    // ─── Notifications (Top-Level) ───────────────────────────────────────────
    match /notifications/{notificationId} {
      // Users can only read their own notifications (addressed by userId or recipientId)
      allow read: if isSignedIn() &&
                     (resource.data.userId == request.auth.uid ||
                      resource.data.get('recipientId', '') == request.auth.uid);
      // Any non-suspended user may notify someone; the target must be named.
      allow create: if isSignedIn() && !isSuspended() && isSafeNotification() &&
                       (request.resource.data.get('userId', '') is string ||
                        request.resource.data.get('recipientId', '') is string);
      // Recipients update their own (isRead, handledByAI, isMutedByAI, ...) but
      // cannot re-address them.
      allow update: if isSignedIn() &&
                       (resource.data.userId == request.auth.uid ||
                        resource.data.get('recipientId', '') == request.auth.uid) &&
                       request.resource.data.get('userId', '') == resource.data.get('userId', '');
      // Users can delete their own notifications; admins can delete any
      allow delete: if isSignedIn() &&
                       (resource.data.userId == request.auth.uid ||
                        resource.data.get('recipientId', '') == request.auth.uid || isAdmin());
    }

    // Collab invites / responses (collab_service)
    match /social_notifications/{notificationId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && !isSuspended() &&
                       request.resource.data.userId is string &&
                       request.resource.data.get('actorId', request.auth.uid) == request.auth.uid;
    }

    // ─── Posts ───────────────────────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && !isSuspended() && request.resource.data.authorId == request.auth.uid;
      // Author edits; anyone else may only bump engagement counters.
      allow update: if isSignedIn() && !isSuspended() && (
        (resource.data.authorId == request.auth.uid && request.resource.data.authorId == resource.data.authorId) ||
        isEngagementCounterUpdate() ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow read: if true;
        allow create: if canCreateComment();
        allow update: if canUpdateComment(postId);
        allow delete: if canDeleteComment(postId);
      }
    }

    // ─── Biz Products ────────────────────────────────────────────────────────
    match /biz_products/{productId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // ─── Comments (Top-Level) ─────────────────────────────────────────────────
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && !isSuspended() && (
        (resource.data.authorId == request.auth.uid &&
         request.resource.data.authorId == resource.data.authorId) ||
        isOwnCommentLikeUpdate() ||
        (onlyChanges(['reactionCount', 'likeCount', 'replyCount']) &&
         stepsByOne('reactionCount') && stepsByOne('likeCount') && stepsByOne('replyCount')) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // ─── Interactions ────────────────────────────────────────────────────────
    match /interactions/{interactionId} {
      allow read, write: if isSignedIn();
    }

    // ─── Relationships ───────────────────────────────────────────────────────
    // Doc id '<followerId>_<followingId>'; only the two users involved may write.
    match /relationships/{relationshipId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && !isSuspended() &&
                       (request.resource.data.get('followerId', '') == request.auth.uid ||
                        request.resource.data.get('followingId', '') == request.auth.uid);
      allow update, delete: if isSignedIn() &&
                       (resource.data.get('followerId', '') == request.auth.uid ||
                        resource.data.get('followingId', '') == request.auth.uid);
    }

    // ─── Stories ─────────────────────────────────────────────────────────────
    match /stories/{storyId} {
      allow read: if true;
      allow create: if isSignedIn() && !isSuspended() && request.resource.data.authorId == request.auth.uid;
      // Author edits; viewers may only record their view / reaction / reply.
      allow update: if isSignedIn() && !isSuspended() && (
        (resource.data.authorId == request.auth.uid &&
         request.resource.data.authorId == resource.data.authorId) ||
        (onlyChanges(['viewers', 'viewCount', 'reactions', 'replyCount', 'likeCount', 'likerIds']) &&
         stepsByOne('viewCount') && stepsByOne('replyCount') && stepsByOne('likeCount')) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());

      // Per-viewer "seen by" docs (doc id == viewer uid).
      match /viewers/{viewerId} {
        allow read: if isSignedIn() &&
                       (viewerId == request.auth.uid ||
                        get(/databases/$(database)/documents/stories/$(storyId)).data.authorId == request.auth.uid);
        allow create, update: if isSignedIn() && viewerId == request.auth.uid;
      }
    }

    // ─── User Stories (Backwards compatibility) ──────────────────────────────
    match /user_stories/{storyId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ─── Projects ────────────────────────────────────────────────────────────
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ─── Tasks ───────────────────────────────────────────────────────────────
    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.createdBy == request.auth.uid);
    }

    // ─── Calendar Events ─────────────────────────────────────────────────────
    match /calendar_events/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.createdBy == request.auth.uid;
      allow delete: if isAdmin() || resource.data.createdBy == request.auth.uid;
    }

    // ─── Equipment ───────────────────────────────────────────────────────────
    match /equipment/{itemId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── Social Connections ──────────────────────────────────────────────────
    match /social_connections/{connectionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ─── Messages / Inbox ────────────────────────────────────────────────────
    match /messages/{messageId} {
      allow read: if isSignedIn() &&
        (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if isSignedIn() && !isSuspended() && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
    }

    // ─── Settings ────────────────────────────────────────────────────────────
    match /settings/{uid} {
      allow read, write: if isOwner(uid);
    }

    // ─── Remote Sessions ─────────────────────────────────────────────────────
    // Unused by the app; the desktop agent (Admin SDK) bypasses rules.
    match /remote_sessions/{document=**} {
      allow read, write: if false;
    }

    // ─── Registered Computers (Linked Devices) ───────────────────────────────
    match /registered_computers/{deviceId} {
      allow read: if isSignedIn() && (resource == null || resource.data.owner_uid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.owner_uid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.owner_uid == request.auth.uid &&
                       request.resource.data.owner_uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.owner_uid == request.auth.uid;

      // Remote-control commands: only the computer's owner (phone and the
      // desktop agent signed in as the same user) may send or read them.
      match /commands/{commandId} {
        allow read, write: if isSignedIn() &&
          get(/databases/$(database)/documents/registered_computers/$(deviceId)).data.owner_uid == request.auth.uid;
      }
      match /{sub}/{rest=**} {
        allow read, write: if isSignedIn() && sub != 'commands' &&
          get(/databases/$(database)/documents/registered_computers/$(deviceId)).data.owner_uid == request.auth.uid;
      }
    }

    // ─── Chats ───────────────────────────────────────────────────────────────
    // Only the people in `participants` can see or write a chat and its messages.
    match /chats/{chatId} {
      function isChatMember() {
        return isSignedIn() &&
               request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.get('participants', []);
      }
      function isChatMemberAfter() {
        return isSignedIn() &&
               request.auth.uid in getAfter(/databases/$(database)/documents/chats/$(chatId)).data.get('participants', []);
      }
      allow read: if isSignedIn() && (resource == null || request.auth.uid in resource.data.get('participants', []));
      allow create: if isSignedIn() && !isSuspended() &&
                       request.auth.uid in request.resource.data.get('participants', []);
      allow update: if isSignedIn() && !isSuspended() &&
                       request.auth.uid in resource.data.get('participants', []);
      allow delete: if isSignedIn() && request.auth.uid in resource.data.get('participants', []);

      match /{document=**} {
        allow read: if isChatMember();
        allow write: if isChatMemberAfter() && !isSuspended();
      }
    }

    // ─── Calls ───────────────────────────────────────────────────────────────
    // Only the host and invited participants see a call, its signaling and
    // participant docs. Existing participants may invite more people.
    match /calls/{callId} {
      function isCallMember() {
        return isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/calls/$(callId)).data.get('participantIds', []) ||
          get(/databases/$(database)/documents/calls/$(callId)).data.get('hostId', '') == request.auth.uid);
      }
      // Writes check the call as it will be after the batch, so a call and
      // its participant docs can be created together.
      function isCallMemberAfter() {
        return isSignedIn() && (
          request.auth.uid in getAfter(/databases/$(database)/documents/calls/$(callId)).data.get('participantIds', []) ||
          getAfter(/databases/$(database)/documents/calls/$(callId)).data.get('hostId', '') == request.auth.uid);
      }
      allow read: if isSignedIn() && (resource == null ||
                     request.auth.uid in resource.data.get('participantIds', []) ||
                     request.auth.uid in resource.data.get('participants', []) ||
                     resource.data.get('hostId', '') == request.auth.uid);
      allow create: if isSignedIn() && !isSuspended() &&
                       request.resource.data.get('hostId', '') == request.auth.uid &&
                       request.auth.uid in request.resource.data.get('participantIds', []);
      allow update: if isSignedIn() &&
                       (request.auth.uid in resource.data.get('participantIds', []) ||
                        resource.data.get('hostId', '') == request.auth.uid) &&
                       request.resource.data.get('hostId', '') == resource.data.get('hostId', '');
      allow delete: if isSignedIn() && resource.data.get('hostId', '') == request.auth.uid;

      match /{document=**} {
        allow read: if isCallMember();
        allow write: if isCallMemberAfter();
      }
    }

    // Unused legacy collection.
    match /call_rooms/{document=**} {
      allow read, write: if false;
    }

    // ─── Live Streams ────────────────────────────────────────────────────────
    match /live_streams/{streamId} {
      // Read: any authenticated user, or public if audienceMode == 'public'
      allow read: if isSignedIn() || resource.data.audienceMode == 'public';

      // Create: authenticated non-suspended user where request.resource.data.hostId == request.auth.uid
      allow create: if isSignedIn() && !isSuspended() &&
                       request.resource.data.hostId == request.auth.uid &&
                       request.resource.data.title is string &&
                       request.resource.data.title.size() > 0 &&
                       request.resource.data.title.size() <= 200 &&
                       request.resource.data.status is string;

      // Update: host, coHosts/moderators, or viewer engagement updates (likes, viewerCount, totalComments)
      allow update: if isSignedIn() && !isSuspended() && (
        // 1. Host or admin update (hostId immutable)
        ((resource.data.hostId == request.auth.uid || isAdmin()) &&
         request.resource.data.hostId == resource.data.hostId) ||
        // 2. Co-hosts or moderators update (hostId immutable)
        ((('coHostIds' in resource.data && resource.data.coHostIds is list && request.auth.uid in resource.data.coHostIds) ||
          ('moderatorIds' in resource.data && resource.data.moderatorIds is list && request.auth.uid in resource.data.moderatorIds)) &&
         request.resource.data.hostId == resource.data.hostId) ||
        // 3. Viewer engagement updates (only viewerCount, totalLikes, totalComments)
        (request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['viewerCount', 'totalLikes', 'totalComments']) &&
         (!('viewerCount' in request.resource.data) || request.resource.data.viewerCount is int || request.resource.data.viewerCount is number) &&
         (!('totalLikes' in request.resource.data) || request.resource.data.totalLikes is int || request.resource.data.totalLikes is number) &&
         (!('totalComments' in request.resource.data) || request.resource.data.totalComments is int || request.resource.data.totalComments is number))
      );

      // Delete: host only (or admin)
      allow delete: if isSignedIn() && (resource.data.hostId == request.auth.uid || isAdmin());

      // ── Subcollection: comments ──
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && !isSuspended() &&
                         request.resource.data.authorId == request.auth.uid &&
                         request.resource.data.text is string &&
                         request.resource.data.text.size() > 0 &&
                         request.resource.data.text.size() <= 1000;
        allow update: if isSignedIn() && !isSuspended() && (
          resource.data.authorId == request.auth.uid ||
          isStreamManager(streamId)
        );
        allow delete: if isSignedIn() && (
          resource.data.authorId == request.auth.uid ||
          isStreamManager(streamId)
        );
      }

      // ── Subcollection: participants ──
      match /participants/{participantId} {
        allow read: if isSignedIn();
        // Viewers write their own doc but cannot make themselves co-host;
        // the host / co-hosts / moderators manage everyone's.
        allow create, update: if isSignedIn() && !isSuspended() && (
          isStreamManager(streamId) ||
          (participantId == request.auth.uid &&
           request.resource.data.get('isCoHost', false) == false &&
           request.resource.data.get('role', 'viewer') in ['viewer', 'audience', 'speaker', 'guest']));
        allow delete: if isSignedIn() && (
          participantId == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          isStreamManager(streamId)
        );
      }

      // ── Subcollection: reactions ──
      match /reactions/{reactionId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && !isSuspended() &&
                         request.resource.data.userId == request.auth.uid;
        allow update: if false;
        allow delete: if isSignedIn() && (
          resource.data.userId == request.auth.uid ||
          isStreamManager(streamId)
        );
      }

      // ── Subcollection: guest_requests ──
      match /guest_requests/{requestId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && !isSuspended() &&
                         request.resource.data.userId == request.auth.uid;
        // Requesters may withdraw but never approve themselves.
        allow update: if isSignedIn() && !isSuspended() && (
          isStreamManager(streamId) ||
          (resource.data.userId == request.auth.uid &&
           request.resource.data.userId == request.auth.uid &&
           request.resource.data.get('status', 'pending') in ['pending', 'cancelled'])
        );
        allow delete: if isSignedIn() && (
          resource.data.userId == request.auth.uid ||
          isStreamManager(streamId)
        );
      }

      // ── Subcollection: signaling (Live Studio WebRTC offers/answers/ICE) ──
      // Any signed-in user may signal, but only as themselves, and only the
      // two peers of a message can read or delete it.
      match /signaling/{signalId} {
        allow read: if isSignedIn() &&
                       (resource.data.to == request.auth.uid ||
                        resource.data.from == request.auth.uid);
        allow create: if isSignedIn() && !isSuspended() &&
                         request.resource.data.from == request.auth.uid &&
                         request.resource.data.to is string &&
                         request.resource.data.type in ['offer', 'answer', 'candidate'];
        allow update: if false;
        allow delete: if isSignedIn() &&
                         (resource.data.to == request.auth.uid ||
                          resource.data.from == request.auth.uid);
      }

      // ── Live Studio v2 (docs/live-studio/ARCHITECTURE.md §6) ──
      // Server-authoritative: only Cloud Functions (Admin SDK, bypasses
      // rules) write these. Clients may read the public parts.
      match /studio/{docId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
      match /members/{uid} {
        allow read: if isSignedIn();
        allow write: if false;
      }
      match /studio_comments/{commentId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
      match /studio_requests/{uid} {
        // Requester sees their own; host / co-hosts / moderators see the queue.
        allow read: if isSignedIn() && (uid == request.auth.uid || isStreamManager(streamId));
        allow write: if false;
      }
      match /studio_counters/{shardId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
      match /studio_rate/{docId} {
        allow read, write: if false;
      }
      match /studio_blocks/{uid} {
        allow read: if isSignedIn() && (uid == request.auth.uid || isStreamManager(streamId));
        allow write: if false;
      }

      match /studio_security/{incidentId} {
        allow read: if isStreamManager(streamId);
        allow write: if false;
      }
      match /studio_security_advisories/{advisoryId} {
        allow read: if isStreamManager(streamId);
        allow write: if false;
      }
      match /studio_security_counters/{docId} {
        allow read, write: if false;
      }
      // Live media E2EE key: never readable by clients (served by lsMediaKey).
      match /studio_secrets/{docId} {
        allow read, write: if false;
      }

      // ── Recursive fallback for any subcollections ──
      // Rules are OR-ed, so the v2 server-only collections are excluded here
      // explicitly (for reads too: studio_secrets holds the media key).
      match /{subcollection}/{rest=**} {
        allow read: if isSignedIn() &&
                       !(subcollection in ['studio_rate', 'studio_security', 'studio_security_advisories',
                                           'studio_security_counters', 'studio_secrets', 'studio_requests',
                                           'studio_blocks']);
        allow write: if isSignedIn() && !isSuspended() && isStreamManager(streamId) &&
                        !(subcollection in ['studio', 'members', 'studio_comments', 'studio_requests',
                                            'studio_counters', 'studio_rate', 'studio_blocks',
                                            'studio_security', 'studio_security_advisories',
                                            'studio_security_counters', 'studio_secrets']);
      }
    }

    // ─── Live Studio v2: watch-party catalog (admin-curated, rights-cleared) ──
    match /live_watch_catalog/{catalogId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── Conversations (canonical inbox, team chats) ─────────────────────────
    // Queried with where('participants', arrayContains: uid).
    match /conversations/{conversationId} {
      function isConvParticipant() {
        return isSignedIn() &&
               request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.get('participants', []);
      }
      allow read: if isSignedIn() && request.auth.uid in resource.data.get('participants', []);
      allow create: if isSignedIn() && !isSuspended() &&
                       request.auth.uid in request.resource.data.get('participants', []);
      allow update: if isSignedIn() && request.auth.uid in resource.data.get('participants', []) &&
                       request.auth.uid in request.resource.data.get('participants', []);
      allow delete: if isSignedIn() && request.auth.uid in resource.data.get('participants', []);

      // messages, attachments, internal_notes, ...
      match /{sub=**} {
        allow read, write: if isConvParticipant();
      }
    }

    // ─── Per-user settings & private docs (doc id == uid) ────────────────────
    match /user_settings/{uid} {
      allow read, write: if isOwner(uid);
    }
    match /account_deletion_requests/{uid} {
      allow create, update: if isOwner(uid);
      allow read: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }
    match /data_exports/{exportId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
    match /creator_analytics/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      match /{sub=**} {
        allow read: if isOwner(uid) || isAdmin();
      }
    }
    match /creators/{uid} {
      allow read: if true;
      allow write: if isOwner(uid) || isAdmin();
      match /{sub=**} {
        allow read: if true;
        allow write: if isOwner(uid) || isAdmin();
      }
    }
    match /ledgers/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      match /{sub=**} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
    }
    // Ova Guard: written only by Cloud Functions (security.ts); owners read.
    match /security_events/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
      match /{sub=**} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if false;
      }
    }
    match /security_state/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
      match /{sub=**} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if false;
      }
    }
    // security_counters, security_rate, legacy_password_hashes and
    // biometric_keys fall through to the deny-all rule at the bottom.
    match /social_messages/{messageId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // ─── Usernames (unique reservation, doc id == lowercase username) ───────
    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid &&
                       request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ─── Hashtags (public counters) ──────────────────────────────────────────
    match /hashtags/{tag} {
      allow read: if true;
      allow create, update: if isSignedIn() && !isSuspended();
      allow delete: if isAdmin();
    }

    // ─── Audio library ───────────────────────────────────────────────────────
    match /audio_tracks/{trackId} {
      allow read: if true;
      allow create: if isSignedIn() && !isSuspended() && ownsData(request.resource.data);
      allow update, delete: if (isSignedIn() && ownsData(resource.data)) || isAdmin();
    }

    // ─── Shop products (search + live shopping) ──────────────────────────────
    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn() && ownsData(request.resource.data);
      allow update, delete: if (isSignedIn() && ownsData(resource.data)) || isAdmin();
    }

    // ─── Media pipeline ──────────────────────────────────────────────────────
    match /media_assets/{assetId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }
    match /media_library/{assetId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && ownsData(request.resource.data);
      allow update, delete: if (isSignedIn() && ownsData(resource.data)) || isAdmin();
    }
    match /video_jobs/{jobId} {
      allow read, create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }
    match /media_rights/{mediaId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && ownsData(request.resource.data);
      allow update, delete: if (isSignedIn() && ownsData(resource.data)) || isAdmin();
    }
    match /videos/{videoId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }
    match /video_analytics/{videoId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── Studio projects (shared workspace, no owner field) ──────────────────
    match /studio_projects/{projectId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn() && (!('createdBy' in resource.data) || ownsData(resource.data) || isAdmin());
    }

    // ─── Calendar events ─────────────────────────────────────────────────────
    match /events/{eventId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isSignedIn() &&
        (!('createdBy' in resource.data) || resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // ─── Workflows ───────────────────────────────────────────────────────────
    match /workflows/{workflowId} {
      allow read, update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }
    match /workflow_executions/{executionId} {
      allow read, write: if isSignedIn();
    }

    // ─── Teams / workspaces ──────────────────────────────────────────────────
    match /workspaces/{workspaceId} {
      function isMember() {
        return isSignedIn() &&
               exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
      }
      allow read, update: if isMember() || isAdmin();
      allow create: if isSignedIn();
      match /{sub=**} {
        allow read: if isMember() || isAdmin();
        allow write: if isMember() || isAdmin();
      }
    }

    // ─── Global search index ─────────────────────────────────────────────────
    match /_search_index/{itemId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.get('allowedViewers', []);
      allow create, update: if isSignedIn() && request.auth.uid in request.resource.data.get('allowedViewers', []);
      allow delete: if isSignedIn() && request.auth.uid in resource.data.get('allowedViewers', []);
    }

    // ─── Moderation & audit (write-once from clients) ────────────────────────
    match /moderation_tickets/{ticketId} {
      allow create: if isSignedIn() && request.resource.data.reportedByUserId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }
    match /moderation_cases/{caseId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }
    match /audit_logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isAdmin() || (isSignedIn() && ownsData(resource.data)) ||
                     (isSignedIn() && resource.data.get('actorId', '') == request.auth.uid);
      allow update, delete: if false;
    }
    match /system_events/{eventId} {
      allow read, create: if isSignedIn();
      allow update, delete: if false;
    }
    // Clients may seed a missing config doc and write the health ping;
    // changing existing config is admin-only.
    match /system_config/{docId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if (isSignedIn() && docId == 'health_ping') || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Device pairing / remote desktop / multicam ──────────────────────────
    match /desktop_pairing/{pin} {
      allow read, write: if isSignedIn();
      match /{sub=**} {
        allow read, write: if isSignedIn();
      }
    }
    match /trusted_device_codes/{code} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /host_shorts_sessions/{sessionId} {
      allow read, write: if isSignedIn();
      match /{sub=**} {
        allow read, write: if isSignedIn();
      }
    }
    match /connectors/{connectorId} {
      allow read: if isSignedIn() && (ownsData(resource.data) || isAdmin());
      allow create: if isSignedIn() && ownsData(request.resource.data);
      allow update, delete: if isSignedIn() && (ownsData(resource.data) || isAdmin());
    }

    // ─── Push notification shards (keyed by uid inside the doc) ─────────────
    // fcm_tokens_shard_N/{token} carries userId; user_notifications_shard_N/{uid}.
    match /{shard}/{docId} {
      allow read, delete: if isSignedIn() && shard.matches('fcm_tokens_shard_[0-9]+') &&
                             resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn() && shard.matches('fcm_tokens_shard_[0-9]+') &&
                               request.resource.data.userId == request.auth.uid &&
                               (resource == null || resource.data.userId == request.auth.uid);
      allow read, write: if isSignedIn() && shard.matches('user_notifications_shard_[0-9]+') &&
                            docId == request.auth.uid;
    }
    match /{shard}/{docId}/{sub=**} {
      allow read, write: if isSignedIn() &&
        shard.matches('user_notifications_shard_[0-9]+') && docId == request.auth.uid;
    }

    // ─── Deny everything else ────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
