rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ─── Helper functions ────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidImageType() {
      return request.resource.contentType.matches('image/.*');
    }

    function isValidAudioType() {
      return request.resource.contentType.matches('audio/.*');
    }

    function isValidVideoType() {
      return request.resource.contentType.matches('video/.*');
    }

    function isUnder50MB() {
      return request.resource.size < 50 * 1024 * 1024;
    }

    function isUnder200MB() {
      return request.resource.size < 200 * 1024 * 1024;
    }

    // ─── User avatars: users/{uid}/avatar.* ──────────────────────────────────
    match /users/{uid}/avatar/{fileName} {
      allow read: if true;
      allow write: if isOwner(uid) && isValidImageType() && isUnder50MB();
      allow delete: if isOwner(uid);
    }

    // ─── User files: users/{uid}/files/** ────────────────────────────────────
    match /users/{uid}/files/{allPaths=**} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isUnder200MB();
      allow delete: if isOwner(uid);
    }

    // ─── Project assets: projects/{projectId}/** ─────────────────────────────
    // Only the project's creator (projects/{id}.createdBy in Firestore) may
    // add or remove files; before, any signed-in user could overwrite them.
    match /projects/{projectId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isProjectCreator(projectId) && isUnder200MB();
      allow delete: if isProjectCreator(projectId);
    }

    function isProjectCreator(projectId) {
      return isSignedIn() &&
        firestore.exists(/databases/(default)/documents/projects/$(projectId)) &&
        firestore.get(/databases/(default)/documents/projects/$(projectId)).data.get('createdBy', '') == request.auth.uid;
    }

    // ─── Audio productions: audio/{uid}/** ───────────────────────────────────
    match /audio/{uid}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) && isValidAudioType() && isUnder200MB();
      allow delete: if isOwner(uid);
    }

    // ─── Video productions: videos/{uid}/** ──────────────────────────────────
    match /videos/{uid}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) && isValidVideoType() && isUnder200MB();
      allow delete: if isOwner(uid);
    }

    // ─── Published posts / reels: content/{uid}/** (upload_service) ─────────
    match /content/{uid}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isOwner(uid) && (isValidImageType() || isValidVideoType()) && isUnder200MB();
      allow delete: if isOwner(uid);
    }

    // ─── High-fidelity masters: masters/{ownerId}/** ─────────────────────────
    match /masters/{uid}/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid) && isUnder200MB();
      allow delete: if isOwner(uid);
    }

    // ─── Voice comments: voice_comments/{contentId}/{uid}_{ts}.m4a ──────────
    match /voice_comments/{contentId}/{fileName} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && fileName.matches(request.auth.uid + '_.*') &&
                       isValidAudioType() && isUnder50MB();
      allow delete: if isSignedIn() && fileName.matches(request.auth.uid + '_.*');
    }

    // ─── Stories media: stories/{fileName} (create_story_sheet) ──────────────
    match /stories/{fileName} {
      allow read: if true;
      allow create: if isSignedIn() && (isValidImageType() || isValidVideoType()) && isUnder200MB();
    }

    // ─── Chat attachments: chats/{chatId}/attachments/** ─────────────────────
    // Folder is a chat id, or 'call_<callId>' for files shared in a call.
    // Only members of that chat / call may upload or list files.
    function isChatOrCallMember(folder) {
      return isSignedIn() && (
        (folder.matches('call_.+') &&
         request.auth.uid in firestore.get(/databases/(default)/documents/calls/$(folder[5:])).data.get('participantIds', [])) ||
        (!folder.matches('call_.+') &&
         request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(folder)).data.get('participants', []))
      );
    }

    match /chats/{chatId}/attachments/{allPaths=**} {
      allow read: if isChatOrCallMember(chatId);
      allow create: if isChatOrCallMember(chatId) && isUnder200MB();
    }

    // ─── Inbox attachment staging: staging/{conversationId}/{uid}/** ─────────
    match /staging/{conversationId}/{uid}/{allPaths=**} {
      allow read, delete: if isOwner(uid);
      allow write: if isOwner(uid) && isUnder200MB();
    }

    // ─── AI voice samples: voice_samples/{uid}.m4a ───────────────────────────
    match /voice_samples/{fileName} {
      allow read, write, delete: if isSignedIn() && fileName == request.auth.uid + '.m4a';
    }

    // ─── AR effects: assets written by Cloud Functions, read by the app ─────
    match /ar_effects/{effectId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // ─── AR effect uploads: ar_effect_uploads/{uid}/{file}.png (staging) ────
    match /ar_effect_uploads/{uid}/{fileName} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && request.resource.contentType == 'image/png' &&
                       request.resource.size < 8 * 1024 * 1024;
    }

    // ─── 3D Shops: shops/{uid}/brand/* and shops/{uid}/products/{id}/* ──────
    // Public read (storefronts are public); only the seller writes.
    function is3dModel() {
      return request.resource.contentType in ['model/gltf-binary', 'model/gltf+json', 'model/vnd.usdz+zip'] ||
             (request.resource.contentType == 'application/octet-stream' &&
              request.resource.name.matches('.*[.](glb|gltf|usdz)$'));
    }
    // Identity check photos (Oneova Pay KYC): the owner uploads JPEGs once;
    // nobody reads them from the app (only the server / review team).
    match /kyc/{uid}/{sessionId}/{fileName} {
      allow read: if false;
      allow create, update: if isOwner(uid)
        && fileName in ['id_front.jpg', 'id_back.jpg', 'selfie.jpg', 'live_left.jpg', 'live_right.jpg']
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size < 10 * 1024 * 1024;
      allow delete: if false;
    }

    // Business verification documents (Oneova ID): owner uploads, nobody reads
    // them from the app (only the server / review team).
    match /kyb/{uid}/{sessionId}/{fileName} {
      allow read: if false;
      allow create, update: if isOwner(uid)
        && fileName.matches('^[a-z0-9_]{2,40}[.](jpg|png|pdf)$')
        && request.resource.contentType in ['image/jpeg', 'image/png', 'application/pdf']
        && request.resource.size < 15 * 1024 * 1024;
      allow delete: if false;
    }

    // Private 3D model library: the owner uploads a source file or product
    // photos and reads the optimized files; nobody else can read any of it.
    match /users/{uid}/models3d/{modelId}/source/{fileName} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && request.resource.size < 100 * 1024 * 1024 &&
                       fileName.matches('^[A-Za-z0-9_.-]{1,80}[.](glb|gltf|obj|stl)$');
      allow update, delete: if false;
    }
    match /users/{uid}/models3d/{modelId}/photos/{fileName} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isValidImageType() && request.resource.size < 12 * 1024 * 1024 &&
                       fileName.matches('^[0-3][.]jpg$');
      allow update, delete: if false;
    }
    match /users/{uid}/models3d/{modelId}/out/{fileName} {
      allow read: if isOwner(uid);
      allow write: if false;
    }
    // Public copies of a model on a product (written by model3dAttach only).
    match /shops/{uid}/products/{productId}/model/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /shops/{uid}/brand/{fileName} {
      allow read: if true;
      allow write: if isOwner(uid) && isValidImageType() && request.resource.size < 10 * 1024 * 1024;
      allow delete: if isOwner(uid);
    }
    // Texture library (rendered on the server) and sellers' own textures.
    match /textures/library/{fileName} {
      allow read: if true;
      allow write: if false;
    }
    match /shops/{uid}/textures/{fileName} {
      allow read: if true;
      allow write: if isOwner(uid) && isValidImageType() && request.resource.size < 10 * 1024 * 1024;
      allow delete: if isOwner(uid);
    }
    match /shops/{uid}/products/{productId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(uid) && (
        (isValidImageType() && request.resource.size < 10 * 1024 * 1024) ||
        (is3dModel() && isUnder50MB()));
      allow delete: if isOwner(uid);
    }

    // ─── Deny everything else ─────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
