rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ─── Helper functions ────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidImageType() {
      return request.resource.contentType.matches('image/.*');
    }

    function isValidAudioType() {
      return request.resource.contentType.matches('audio/.*');
    }

    function isValidVideoType() {
      return request.resource.contentType.matches('video/.*');
    }

    function isUnder50MB() {
      return request.resource.size < 50 * 1024 * 1024;
    }

    function isUnder200MB() {
      return request.resource.size < 200 * 1024 * 1024;
    }

    // ─── User avatars: users/{uid}/avatar.* ──────────────────────────────────
    match /users/{uid}/avatar/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) && isValidImageType() && isUnder50MB();
      allow delete: if isOwner(uid);
    }

    // ─── User files: users/{uid}/files/** ────────────────────────────────────
    match /users/{uid}/files/{allPaths=**} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isUnder200MB();
      allow delete: if isOwner(uid);
    }

    // ─── Project assets: projects/{projectId}/** ─────────────────────────────
    match /projects/{projectId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isUnder200MB();
      allow delete: if isSignedIn();
    }

    // ─── Audio productions: audio/{uid}/** ───────────────────────────────────
    match /audio/{uid}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) && isValidAudioType() && isUnder200MB();
      allow delete: if isOwner(uid);
    }

    // ─── Video productions: videos/{uid}/** ──────────────────────────────────
    match /videos/{uid}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) && isValidVideoType() && isUnder200MB();
      allow delete: if isOwner(uid);
    }

    // ─── Reel uploads: reels/uploads/{uid}/{contentId}/original ──────────────
    // Write-once raw upload. Only the reels worker reads it (Admin SDK); viewers
    // get the transcoded HLS from the public reels bucket behind Cloud CDN.
    match /reels/uploads/{uid}/{contentId}/{fileName} {
      allow read: if false;
      allow create: if isOwner(uid) && fileName.matches('original\\.[a-zA-Z0-9]+') &&
                    isValidVideoType() && isUnder200MB();
      allow update, delete: if false;
    }

    // ─── Deny everything else ─────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
